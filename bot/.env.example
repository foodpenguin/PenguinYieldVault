# ===== Required =====
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PRIVATE_KEY_HEX=0xYOUR_PRIVATE_KEY

# Bot modes
ENABLE_ARBITRAGE_BOT=true
ENABLE_REBALANCE_BOT=false
DRY_RUN=true

# ===== Arbitrage mode required =====
ATOMIC_EXECUTOR_ADDRESS=0xYOUR_EXECUTOR
SOURCE_ADDRESS=0xYOUR_SOURCE
VAULT_ADDRESS=0xYOUR_VAULT

# ===== Rebalance mode required when ENABLE_REBALANCE_BOT=true =====
STRATEGY_ROUTER_ADDRESS=0xYOUR_ROUTER
# REBALANCE_SOURCE_ADDRESS=0xYOUR_LP_SOURCE
# REBALANCE_POOL_ADDRESS=0x6418EEC70f50913ff0d756B48d32Ce7C02b47C47
# POSITION_MANAGER_ADDRESS=0x1238536071E1c677A632429e3655c799b22cDA52

# Runtime
CHAIN_ID=11155111
AMOUNT_IN_WEI=100000000000000000
MIN_PROFIT_WEI=10000000000000000
MIN_NET_PROFIT_WEI=1000000000000000
MAX_LOSS_BPS=300
ARBITRAGE_MAX_TRADE_BPS=1000
SLIPPAGE_BPS=50
DEADLINE_SEC=30
LOOP_INTERVAL_SEC=5
MAX_GAS_LIMIT=700000

# Strategy params mode: amm | dummy | raw
STRATEGY_MODE=amm
DUMMY_PAYOUT_WEI=20000000000000000
RAW_STRATEGY_PARAMS_HEX=

# Rebalance controls
REBALANCE_GAS_LIMIT=1200000
REBALANCE_ATR_LENGTH=14
REBALANCE_ATR_PERIOD_SEC=3600
REBALANCE_ATR_MULTIPLIER=2.0
REBALANCE_RANGE_BPS_MIN=1000
REBALANCE_RANGE_BPS_MAX=1500
REBALANCE_ADX_LENGTH=14
REBALANCE_ADX_PERIOD_SEC=86400
REBALANCE_ADX_TREND_THRESHOLD=25
REBALANCE_EXPECTED_FEE_DAYS=7
REBALANCE_DAILY_VOLUME_ASSET=0
REBALANCE_TRIGGER_ZONE_BPS=2000
REBALANCE_COST_MULTIPLIER_BPS=15000
REBALANCE_PAYBACK_THRESHOLD_HOURS=72
REBALANCE_STATE_FILE=./rebalance_state.json
REBALANCE_MIN_SWAP_OUT=1
REBALANCE_AMOUNT0_MIN=0
REBALANCE_AMOUNT1_MIN=0
REBALANCE_PRINCIPAL_TO_SETTLE=0
REBALANCE_MAX_LOSS_BPS=10000
REBALANCE_MIN_RETURNED_ASSETS=0
REBALANCE_BURN_POSITION=true

# Optional token overrides (defaults are Sepolia)
# WETH_ADDRESS=0xfFf9976782d46CC05630D1f6eBAb18b2324d6B14
# METH_ADDRESS=0x4f7A67464B5976d7547c860109e4432d50AfB38e
# UNI_ADDRESS=0x1f9840a85d5aF5bf1D1762F925BDADdC4201F984
# USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
