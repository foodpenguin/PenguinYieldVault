# ===== Required Configuration =====
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PRIVATE_KEY_HEX=0xYOUR_PRIVATE_KEY_HERE
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY_HERE

# ===== Bot Operational Modes =====
ENABLE_ARBITRAGE_BOT=true
ENABLE_REBALANCE_BOT=true
DRY_RUN=false

# ===== Deployed Contract Addresses (Sepolia Example) =====
VAULT_ADDRESS=0xd38c4f064ae1436bc2d497c5f282ff0280abcecd
BOT_REGISTRY_ADDRESS=0x43882b30a442b347bc0bf315a392b02222a8048e
STRATEGY_ROUTER_ADDRESS=0xc469c8a5769db7fc9e8f1d015794a26a1f840ff0
ATOMIC_EXECUTOR_ADDRESS=0x8709303256954be145ac2f34fdfd5b7af8084a7f
SOURCE_ADDRESS=0x82904bead5fb7659b8b5f4034053f9c57e59a749

# ===== Arbitrage Parameters =====
AMOUNT_IN_WEI=100000000000000000    # 0.1 ETH 交易量
MIN_PROFIT_WEI=50000000000000       # 50,000 Gwei (0.00005 ETH) 鏈上過濾門檻
MIN_NET_PROFIT_WEI=50000000000000   # 50,000 Gwei (0.00005 ETH) 淨利潤門檻
MAX_LOSS_BPS=500                    # 5% 最大容忍損失
ARBITRAGE_MAX_TRADE_BPS=2000        # 20% 單次最大交易佔比
SLIPPAGE_BPS=100                    # 1% 交易滑點保護
DEADLINE_SEC=60                     # 60秒 交易時效限制
LOOP_INTERVAL_SEC=60                # 60秒 巡檢間隔 (避免高頻死循環)
MAX_GAS_LIMIT=800000                # 單次套利 Gas 上限
STRATEGY_MODE=amm                   # 策略模式: amm / dummy / raw

# ===== Rebalance Parameters (Uniswap V3 LP) =====
REBALANCE_SOURCE_ADDRESS=0xe237e001bad30b65324c19df459c4208a9532b55
REBALANCE_POOL_ADDRESS=0x6418EEC70f50913ff0d756B48d32Ce7C02b47C47
POSITION_MANAGER_ADDRESS=0x1238536071E1c677A632429e3655c799b22cDA52
# REBALANCE_GAS_LIMIT=1200000
REBALANCE_ATR_LENGTH=2
REBALANCE_ATR_PERIOD_SEC=60
# REBALANCE_ATR_MULTIPLIER=2.0
# REBALANCE_RANGE_BPS_MIN=1000
# REBALANCE_RANGE_BPS_MAX=1500
REBALANCE_ADX_LENGTH=2
REBALANCE_ADX_PERIOD_SEC=60
REBALANCE_ADX_TREND_THRESHOLD=0.1
REBALANCE_EXPECTED_FEE_DAYS=7.0     # 模擬預估手續費天數
REBALANCE_DAILY_VOLUME_ASSET=50.0   # 模擬每日池子交易量(ETH)，防止測試網無手續費導致無限撤資循環
REBALANCE_TRIGGER_ZONE_BPS=2000
REBALANCE_COST_MULTIPLIER_BPS=15000
REBALANCE_PAYBACK_THRESHOLD_HOURS=72
REBALANCE_STATE_FILE=./rebalance_state.json
REBALANCE_MIN_SWAP_OUT=1
REBALANCE_AMOUNT0_MIN=0
REBALANCE_AMOUNT1_MIN=0
REBALANCE_PRINCIPAL_TO_SETTLE=0
REBALANCE_MAX_LOSS_BPS=10000
REBALANCE_MIN_RETURNED_ASSETS=0
REBALANCE_BURN_POSITION=true

# ===== Sepolia Token Addresses =====
WETH_ADDRESS=0xfFf9976782d46CC05630D1f6eBAb18b2324d6B14
METH_ADDRESS=0x4f7A67464B5976d7547c860109e4432d50AfB38e
UNI_ADDRESS=0x1f9840a85d5aF5bf1D1762F925BDADdC4201F984
USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
